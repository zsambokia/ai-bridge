{
  "configuration": {
    "default_hosts": [
      "stage.artificial-software-factory.com",
      "app.artificial-software-factory.com"
    ],
    "environment_variable": "DJANGO_ALLOWED_HOSTS",
    "wildcard_policy": "rejected"
  },
  "django_client_validation": [
    {
      "host": "stage.artificial-software-factory.com",
      "path": "/health/",
      "status_code": 200,
      "result": "accepted"
    },
    {
      "host": "app.artificial-software-factory.com",
      "path": "/health/",
      "status_code": 200,
      "result": "accepted"
    },
    {
      "host": "unapproved.example.test",
      "path": "/health/",
      "status_code": 400,
      "result": "rejected"
    }
  ]
}
