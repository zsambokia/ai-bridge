<mxfile host="app.diagrams.net" modified="2026-08-11T00:00:00.000Z" agent="Codex" version="24.7.17"><diagram id="full-architecture" name="Full Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="AI Bridge — Full Target Architecture&#xa;Status: CANONICAL | Logical source: 99_FULL_ARCHITECTURE.md (Mermaid) | Draw.io is derived" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="220" y="20" width="1360" height="45" as="geometry"/></mxCell><mxCell id="legend" value="Green: Canonical target | Yellow: Transitional | Grey: Historical" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="500" y="65" width="800" height="25" as="geometry"/></mxCell><mxCell id="po" value="Product Owner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="130" width="140" height="50" as="geometry"/></mxCell><mxCell id="fc" value="Factory Chat" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;" vertex="1" parent="1"><mxGeometry x="250" y="130" width="140" height="50" as="geometry"/></mxCell><mxCell id="convbox" value="Conversation Layer&#xa;Conversation → Conversation State Engine&#xa;Conversation Understanding → Context Builder → Mission Resolution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;align=left;spacingLeft=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="450" y="105" width="410" height="100" as="geometry"/></mxCell><mxCell id="knowbox" value="Knowledge &amp; Repository&#xa;Repository + AKB + Semantic Layer&#xa;→ Context Package (immutable, versioned, reproducible)&#xa;Context Package → Mission Resolution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;align=left;spacingLeft=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="930" y="105" width="420" height="100" as="geometry"/></mxCell><mxCell id="rb" value="RUNTIME BOUNDARY" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="250" y="255" width="1100" height="30" as="geometry"/></mxCell><mxCell id="missionbox" value="Mission Domain&#xa;Mission → Mission State Machine → Operational Work Item (immutable)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;align=left;spacingLeft=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="370" y="310" width="500" height="75" as="geometry"/></mxCell><mxCell id="adapters" value="API / MCP / Scheduler / Webhook / Automation&#xa;converge directly on Mission intake" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;align=center;fontSize=13;" vertex="1" parent="1"><mxGeometry x="980" y="310" width="330" height="75" as="geometry"/></mxCell><mxCell id="foundation" value="Operational Foundation&#xa;Admission → Capability Resolution → Capability Registry → Engine Definition Registry → Scheduler → Queue → Lease Manager&#xa;Policy: Configuration | Governance: Retry, Recovery | Observation: Health Monitor, Telemetry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;align=left;spacingLeft=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="210" y="440" width="1180" height="90" as="geometry"/></mxCell><mxCell id="engines" value="Operational Engines — stateless capability definitions&#xa;Planning | Workflow | Knowledge | Repository | Reflection | Documentation | Deployment | Learning&#xa;Each engine requests an Execution; no engine owns Execution state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;align=left;spacingLeft=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="210" y="590" width="1180" height="80" as="geometry"/></mxCell><mxCell id="kernel" value="AI Kernel&#xa;Execution Request → Execution (Kernel-owned)&#xa;Execution → Provider Integration → Provider Resolver → Provider (stateless) → Provider Executor (stateful)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;align=left;spacingLeft=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="210" y="730" width="1180" height="85" as="geometry"/></mxCell><mxCell id="history" value="Historical / Transitional implementation vocabulary (not target architecture)&#xa;ExecutionRun | ExecutionJob | Provider Gateway&#xa;Final disposition is ADR-governed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f2f3f4;strokeColor=#7f8c8d;dashed=1;align=left;spacingLeft=10;fontSize=14;" vertex="1" parent="1"><mxGeometry x="420" y="875" width="760" height="75" as="geometry"/></mxCell><mxCell id="e1" edge="1" parent="1" source="po" target="fc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" edge="1" parent="1" source="fc" target="convbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" edge="1" parent="1" source="convbox" target="missionbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" edge="1" parent="1" source="knowbox" target="convbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" edge="1" parent="1" source="missionbox" target="foundation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" edge="1" parent="1" source="adapters" target="missionbox" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" edge="1" parent="1" source="foundation" target="engines" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e8" edge="1" parent="1" source="engines" target="kernel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e9" edge="1" parent="1" source="history" target="kernel" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;dashed=1;strokeColor=#7f8c8d;"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
