<mxfile host="app.diagrams.net" modified="2026-08-14T00:00:00.000Z" agent="Codex" version="24.7.17"><diagram id="full-architecture" name="Full Architecture"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1800" pageHeight="1200"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="AI Bridge — Full Target Architecture&#xa;CANONICAL | Derived from 99_FULL_ARCHITECTURE.md" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#172554;" vertex="1" parent="1"><mxGeometry x="220" y="20" width="1360" height="45" as="geometry"/></mxCell><mxCell id="po" value="Product Owner" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;" vertex="1" parent="1"><mxGeometry x="60" y="120" width="140" height="50" as="geometry"/></mxCell><mxCell id="fc" value="Factory Chat&#xa;UI / interaction only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;" vertex="1" parent="1"><mxGeometry x="250" y="120" width="170" height="50" as="geometry"/></mxCell><mxCell id="conversation" value="Conversation domain (durable)&#xa;Context Assembly → Understanding → Evaluation&#xa;(stateless, immutable results) → CSE → Mission Resolution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="470" y="100" width="560" height="95" as="geometry"/></mxCell><mxCell id="knowledge" value="Repository + AKB + Semantic Layer&#xa;→ immutable, versioned Context Package" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="1100" y="100" width="400" height="95" as="geometry"/></mxCell><mxCell id="factoryip" value="FactoryIP foundation&#xa;L0 Effective Scope → L1 Evidence → L2 Provenance → L3 Artifact / Knowledge Candidate → L4 Factory Packet&#xa;FFS: control-plane resolution | Zoning: transport permission" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="250" y="250" width="1280" height="75" as="geometry"/></mxCell><mxCell id="mission" value="Mission domain&#xa;Mission → MSM → immutable Operational Work Item" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="370" y="380" width="500" height="75" as="geometry"/></mxCell><mxCell id="foundation" value="Operational Foundation&#xa;Admission → Capability Resolution → Registries → Scheduler / Queue / Lease&#xa;Policy, Retry, Recovery, Health, Telemetry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="210" y="520" width="1180" height="80" as="geometry"/></mxCell><mxCell id="engines" value="Operational Engines — stateless capability definitions&#xa;Each engine requests an Execution; no engine owns Execution state." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="210" y="660" width="1180" height="70" as="geometry"/></mxCell><mxCell id="kernel" value="AI Kernel (post-admission; not Cognitive Processing)&#xa;Execution Request → Kernel-owned Execution → Provider Integration → Resolver → Provider → Executor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5f5e3;strokeColor=#1e8449;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="210" y="790" width="1180" height="75" as="geometry"/></mxCell><mxCell id="e1" edge="1" parent="1" source="po" target="fc" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" edge="1" parent="1" source="fc" target="conversation" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" edge="1" parent="1" source="knowledge" target="conversation" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;dashed=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e4" edge="1" parent="1" source="conversation" target="mission" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e5" edge="1" parent="1" source="mission" target="foundation" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e6" edge="1" parent="1" source="foundation" target="engines" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e7" edge="1" parent="1" source="engines" target="kernel" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
