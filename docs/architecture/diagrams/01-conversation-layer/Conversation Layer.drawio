<mxfile host="app.diagrams.net" modified="2026-08-11T00:00:00.000Z" agent="Codex" version="26.0.14" type="device">
  <diagram id="conversation-layer-01" name="Conversation Layer">
    <mxGraphModel dx="1600" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1654" pageHeight="2339" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="AI Bridge — Conversation Layer&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Canonical target architecture · Article IV&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;fontSize=28;fontStyle=1;fontColor=#172554;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="1040" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="product-owner" value="&lt;b&gt;Product Owner&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Responsibility: supplies business intent, approvals, and governing decisions.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E5E7EB;strokeColor=#475569;fontColor=#0F172A;fontSize=19;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="105" width="800" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="factory-chat" value="&lt;b&gt;Factory Chat&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Responsibility: localized UI adapter for messages, attachments, streaming, approvals, and projections; never owns business state.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;fontColor=#172554;fontSize=19;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="275" width="800" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="conversation" value="&lt;b&gt;Conversation&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Responsibility: owns the durable human interaction record, history, attachments, participants, Persona references, and conversation-specific state.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;fontColor=#14532D;fontSize=19;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="460" width="800" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="understanding" value="&lt;b&gt;Conversation Understanding&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Responsibility: classifies intent and goal, assembles context, and performs governed Conversation, Mission, AKB, Repository, semantic, and LLM analysis.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#14532D;fontSize=19;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="645" width="800" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="cse" value="&lt;b&gt;Conversation State Engine&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Responsibility: the exclusive Conversation Domain progression owner; evaluates maturity, missing information, alternatives, decision points, and Mission necessity.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#14532D;fontSize=19;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="835" width="800" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="mission-resolution" value="&lt;b&gt;Mission Resolution&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Responsibility: exclusive human-Conversation Mission-intake boundary; decides new Mission, update, closure, or no runtime action.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#14532D;fontSize=19;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="1025" width="800" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="runtime-boundary" value="&lt;b&gt;RUNTIME BOUNDARY&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:14px&quot;&gt;Mission is the first business object that may enter the operational runtime path.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=3;dashed=1;fontColor=#9A3412;fontSize=19;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="1215" width="1040" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="mission" value="&lt;b&gt;Mission&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:15px&quot;&gt;Responsibility: first runtime business object; carries immutable identity, goal, scope, priority, ownership, metadata, state, correlation, and evidence references. MSM owns its lifecycle.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7E22CE;fontColor=#581C87;fontSize=19;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="1365" width="800" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="edge-po-chat" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;strokeWidth=2;" edge="1" parent="1" source="product-owner" target="factory-chat">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-chat-conversation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#2563EB;strokeWidth=2;" edge="1" parent="1" source="factory-chat" target="conversation">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-conversation-understanding" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=2;" edge="1" parent="1" source="conversation" target="understanding">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-understanding-cse" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=2;" edge="1" parent="1" source="understanding" target="cse">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-cse-resolution" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#16A34A;strokeWidth=2;" edge="1" parent="1" source="cse" target="mission-resolution">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-resolution-boundary" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#EA580C;strokeWidth=2;" edge="1" parent="1" source="mission-resolution" target="runtime-boundary">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-boundary-mission" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7E22CE;strokeWidth=2;" edge="1" parent="1" source="runtime-boundary" target="mission">
          <mxGeometry relative="1" as="geometry"/>
